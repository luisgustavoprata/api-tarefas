# Copie para .env e ajuste. Gere uma chave com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Vazio: SQLite no arquivo tarefas.db. Produção: postgresql://usuario:senha@host:5432/banco
DATABASE_URL=
TOKEN_MINUTES=60
APP_TIMEZONE=America/Sao_Paulo
# true: cria a conta demo@tarefas.dev (senha demo12345) com tarefas de exemplo
SEED_DEMO=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
# Origens liberadas para chamar a API pelo navegador, separadas por vírgula
CORS_ORIGINS=*
# production: exige SECRET_KEY definida
ENVIRONMENT=development
